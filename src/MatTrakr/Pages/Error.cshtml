@page
@model ErrorModel
@{
    ViewData["Title"] = "Fehler";
}

<div class="mat-alert mat-alert--danger" role="alert">
    @Ui.Icon("alert")
    <div>
        <strong>Es ist ein Fehler aufgetreten.</strong>
        @if (Model.ShowRequestId)
        {
            <div class="mat-mt-1">Request-ID: <code>@Model.RequestId</code></div>
        }
    </div>
</div>

<a href="/" class="mat-btn mat-btn--secondary mat-mt-4">@Ui.Icon("home")<span>Zur Startseite</span></a>
