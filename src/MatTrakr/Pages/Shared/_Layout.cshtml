@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // A page may set: Title (the page heading and the last crumb), Description (one line under the title),
    // NoHeading (the page draws its own head) and Width ("narrow" or "wide").
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string;
    var showHeading = ViewData["NoHeading"] is not true && !string.IsNullOrEmpty(title);
    var width = ViewData["Width"] as string;
    var version = Environment.GetEnvironmentVariable("MATTRAKR_VERSION") ?? "local";
}
<!DOCTYPE html>
<html lang="de" data-app="mattrakr" @Ui.ToolkitTexts>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(string.IsNullOrEmpty(title) ? "MatTrakr" : title + " · MatTrakr")</title>
    <script src="~/matui/matui.boot.js"></script>
    <link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <partial name="_PwaHead" />
</head>
<body>
    <a class="mat-skip" href="#main">Zum Inhalt springen</a>
    @Ui.Sprite(Env.WebRootPath)

    <div class="mat-app">
        @await Component.InvokeAsync("Sidebar")

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="Menü umschalten" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="Brotkrumen">
                    <ol>
                        <li><a href="/" aria-label="Startseite">@Ui.Icon("home")</a></li>
                        <li aria-current="page">@(string.IsNullOrEmpty(title) ? "MatTrakr" : title)</li>
                    </ol>
                </nav>
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "")" id="main">
                @if (showHeading)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(description))
                            {
                                <p class="mat-page__sub">@description</p>
                            }
                        </div>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
