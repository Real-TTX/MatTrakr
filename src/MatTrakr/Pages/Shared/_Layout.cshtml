<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MatTrakr</title>
    <partial name="_ThemeHead" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <!-- Mobile top bar -->
    <header class="app-topbar d-lg-none">
        <button class="btn btn-link app-topbar-toggle" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar"
                aria-label="Menü öffnen">
            <i class="bi bi-list"></i>
        </button>
        <a href="/" class="app-topbar-brand">
            <i class="bi bi-collection-play"></i> MatTrakr
        </a>
    </header>

    <div class="app-shell">
        <!-- Sidebar: static on desktop, offcanvas on mobile -->
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar">
            @await Component.InvokeAsync("Sidebar")
        </aside>

        <main class="app-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
