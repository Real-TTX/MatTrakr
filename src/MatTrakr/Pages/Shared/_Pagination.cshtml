@model MatTrakr.ViewComponents.PaginationModel

@functions {
    private string PageUrl(int page)
    {
        var query = new List<string>();
        foreach (var kv in Model.Query)
        {
            if (!string.IsNullOrEmpty(kv.Value) && kv.Key != Model.PageParam)
                query.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}");
        }
        query.Add($"{Model.PageParam}={page}");
        return "?" + string.Join("&", query);
    }
}

@if (Model.TotalPages > 1)
{
    <nav class="mat-pager" aria-label="Seiten" id="@Model.Id">
        <span class="mat-pager__info">@Model.TotalCount Einträge</span>
        <div class="mat-pager__pages">
            @if (Model.Page <= 1)
            {
                <span class="mat-pager__btn is-disabled" aria-hidden="true">@Ui.Icon("chevron-left")</span>
            }
            else
            {
                <a class="mat-pager__btn" href="@PageUrl(Model.Page - 1)" aria-label="Zurück">@Ui.Icon("chevron-left")</a>
            }

            @{
                var start = Math.Max(1, Model.Page - 2);
                var end = Math.Min(Model.TotalPages, Model.Page + 2);
            }
            @if (start > 1)
            {
                <a class="mat-pager__btn" href="@PageUrl(1)">1</a>
                @if (start > 2)
                {
                    <span class="mat-pager__gap">…</span>
                }
            }
            @for (var p = start; p <= end; p++)
            {
                if (p == Model.Page)
                {
                    <span class="mat-pager__btn is-current" aria-current="page">@p</span>
                }
                else
                {
                    <a class="mat-pager__btn" href="@PageUrl(p)">@p</a>
                }
            }
            @if (end < Model.TotalPages)
            {
                @if (end < Model.TotalPages - 1)
                {
                    <span class="mat-pager__gap">…</span>
                }
                <a class="mat-pager__btn" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a>
            }

            @if (Model.Page >= Model.TotalPages)
            {
                <span class="mat-pager__btn is-disabled" aria-hidden="true">@Ui.Icon("chevron-right")</span>
            }
            else
            {
                <a class="mat-pager__btn" href="@PageUrl(Model.Page + 1)" aria-label="Weiter">@Ui.Icon("chevron-right")</a>
            }
        </div>
    </nav>
}
