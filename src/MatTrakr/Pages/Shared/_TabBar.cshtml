@model MatTrakr.ViewComponents.TabBarModel

<div class="mat-tabs" id="@Model.Id" role="tablist">
    @foreach (var tab in Model.Tabs)
    {
        <a class="mat-tab @(tab.Key == Model.ActiveKey ? "is-active" : null)" href="@(tab.Url ?? "#")"
           aria-selected="@(tab.Key == Model.ActiveKey ? "true" : "false")">
            @if (!string.IsNullOrEmpty(tab.Icon))
            {
                @Ui.Icon(tab.Icon)
            }
            <span>@tab.Text</span>
            @if (tab.Badge is not null)
            {
                <span class="mat-badge mat-badge--soft">@tab.Badge</span>
            }
        </a>
    }
</div>
