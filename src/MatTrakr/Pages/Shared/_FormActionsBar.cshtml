@model MatTrakr.ViewComponents.FormActionsModel

@*
    Buttons in one row, positive → negative: Save, Back, <spacer>, Delete (FORM-01).
    mat-btn-row enforces the order; the delete button submits its own hidden form
    (see _DeleteForm) and confirms through the toolkit dialog (data-confirm).
*@
<div class="mat-btn-row">
    <button type="submit" class="mat-btn mat-btn--primary">
        @if (!string.IsNullOrEmpty(Model.SaveIcon))
        {
            @Ui.Icon(Model.SaveIcon)
        }
        <span>@Model.SaveText</span>
    </button>
    @if (!string.IsNullOrEmpty(Model.BackUrl))
    {
        <a href="@Model.BackUrl" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>@Model.BackText</span></a>
    }

    @if (!string.IsNullOrEmpty(Model.DeleteHandler))
    {
        <span class="mat-btn-row__spacer"></span>
        <button type="submit" class="mat-btn mat-btn--danger"
                form="@($"deleteForm_{Model.DeleteHandler}")"
                data-confirm="@(Model.DeleteConfirm ?? "Wirklich löschen?")" data-confirm-ok="Löschen">
            @Ui.Icon("trash")<span>@Model.DeleteText</span>
        </button>
    }
</div>
