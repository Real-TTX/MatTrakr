@page "/Shared/{token}"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Public.SharedModel
@{
    ViewData["Title"] = Model.List.Name;
    Layout = null;
    var typeIcon = Model.List.Type switch
    {
        MediaType.Movies => "bi-film",
        MediaType.Series => "bi-tv",
        MediaType.Books => "bi-book",
        _ => "bi-collection",
    };
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.List.Name · MatTrakr</title>
    <partial name="_ThemeHead" />
    <partial name="_PwaHead" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-topbar">
        <span class="app-topbar-brand ms-2">
            <i class="bi bi-collection-play"></i> MatTrakr
        </span>
        <span class="badge text-bg-secondary ms-auto me-2">Geteilte Liste · Nur Lesen</span>
        <partial name="_ThemeSwitch" model="@((string?)null)" />
    </header>

    <main class="app-main container-lg">
        <h1 class="page-title"><i class="bi @typeIcon"></i>@Model.List.Name</h1>

        <partial name="_TableToolbar" model="@(new TableToolbarModel
        {
            Id = "sharedToolbar",
            SearchValue = Model.Q,
            SearchPlaceholder = "Titel suchen …",
            Filters =
            {
                new ToolbarFilter
                {
                    Name = "status", Label = "Status", Selected = Model.StatusFilter,
                    Options =
                    {
                        ("", "Alle"),
                        ("open", Model.OpenWord),
                        ("done", Model.DoneWord),
                    },
                },
            },
        })" />

        @if (Model.Items.Count == 0)
        {
            <div class="content-card p-5 text-center text-muted">
                <i class="bi @typeIcon display-4 d-block mb-3 opacity-50"></i>
                <p class="mb-0">Keine Einträge vorhanden.</p>
            </div>
        }
        else
        {
            <div class="media-grid">
                @foreach (var item in Model.Items)
                {
                    var done = item.Status == ItemStatus.Done;
                    <div class="media-card @(done ? "is-done" : null)">
                        <div class="media-card-cover-link">
                            @if (!string.IsNullOrEmpty(item.CoverUrl))
                            {
                                <img src="@item.CoverUrl" alt="@item.Title" class="media-card-cover" loading="lazy" />
                            }
                            else
                            {
                                <div class="media-card-cover media-card-cover-placeholder">
                                    <i class="bi @typeIcon"></i>
                                </div>
                            }
                            <span class="media-card-status badge @(done ? "text-bg-success" : "text-bg-secondary")">
                                <i class="bi @(done ? "bi-check-lg" : "bi-hourglass")"></i>
                                @(done ? Model.DoneWord : Model.OpenWord)
                            </span>
                        </div>
                        <div class="media-card-body">
                            <div class="media-card-title" title="@item.Title">@item.Title</div>
                            <div class="media-card-year">@item.Year</div>
                        </div>
                    </div>
                }
            </div>
        }

        <partial name="_Pagination" model="@(new PaginationModel
        {
            Id = "sharedPagination",
            Page = Model.PageNumber,
            PageSize = Model.PageSizeValue,
            TotalCount = Model.TotalCount,
            Query = new Dictionary<string, string?>
            {
                ["q"] = Model.Q,
                ["status"] = Model.StatusFilter,
            },
        })" />
    </main>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
