@page "/Shared/{token}"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model MatTrakr.Pages.Public.SharedModel
@{
    ViewData["Title"] = Model.List.Name;
    Layout = null;
    var typeIcon = Model.List.Type switch
    {
        MediaType.Movies => "film",
        MediaType.Series => "tv",
        MediaType.Books => "book",
        _ => "collection",
    };
}
<!DOCTYPE html>
<html lang="de" data-app="mattrakr" @Ui.ToolkitTexts>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@Model.List.Name · MatTrakr</title>
    <script src="~/matui/matui.boot.js"></script>
    <link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <partial name="_PwaHead" />
</head>
<body>
    <a class="mat-skip" href="#main">Zum Inhalt springen</a>
    @Ui.Sprite(Env.WebRootPath)

    <header class="mt-public-bar">
        <span class="mt-public-brand">
            <span class="mat-logo" aria-hidden="true">@Ui.Logo</span>
            <span>MatTrakr</span>
        </span>
        <span class="mat-pill mat-pill--plain mt-push-end">Geteilte Liste · Nur Lesen</span>
        <button type="button" class="mat-theme" data-theme-toggle data-theme-state="system" aria-label="Design umschalten" title="Design umschalten"
                data-theme-name-system="System" data-theme-name-light="Hell" data-theme-name-dark="Dunkel">
            <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
            <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
            <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
        </button>
    </header>

    <main class="mt-public-main" id="main">
        <div class="mat-page__head">
            <div class="mat-page__title"><h1>@Model.List.Name</h1></div>
        </div>

        <partial name="_TableToolbar" model="@(new TableToolbarModel
        {
            Id = "sharedToolbar",
            SearchValue = Model.Q,
            SearchPlaceholder = "Titel suchen …",
            Filters =
            {
                new ToolbarFilter
                {
                    Name = "status", Label = "Status", Selected = Model.StatusFilter,
                    Options = Model.List.Type == MediaType.Series
                        ? new() { ("", "Alle"), ("open", Model.OpenWord), ("partial", "Teilweise"), ("done", Model.DoneWord), ("abandoned", "Abgebrochen") }
                        : new() { ("", "Alle"), ("open", Model.OpenWord), ("done", Model.DoneWord), ("abandoned", "Abgebrochen") },
                },
            },
        })" />

        @if (Model.Items.Count == 0)
        {
            <div class="mat-empty">
                <div class="mat-empty__icon">@Ui.Icon(typeIcon)</div>
                <p class="mat-empty__title">Keine Einträge vorhanden.</p>
            </div>
        }
        else
        {
            <div class="mat-gallery mt-gallery">
                @foreach (var item in Model.Items)
                {
                    var done = item.Status == ItemStatus.Done;
                    var badge = StatusDisplay.Badge(item, Model.List.Type);
                    var above = Model.StatusPosition == CardStatusPosition.Above;
                    <div class="mat-tile mt-tile @(done ? "is-done" : null)">
                        @if (above)
                        {
                            <div class="mt-statusbar mt-statusbar--above mt-statusbar--@badge.Key">@Ui.Icon(badge.Icon)<span>@badge.Text</span></div>
                        }
                        <div class="mat-tile__media mt-cover">
                            @if (!string.IsNullOrEmpty(item.CoverUrl))
                            {
                                <img src="@item.CoverUrl" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                @Ui.Icon(typeIcon)
                            }
                        </div>
                        @if (!above)
                        {
                            <div class="mt-statusbar mt-statusbar--below mt-statusbar--@badge.Key">@Ui.Icon(badge.Icon)<span>@badge.Text</span></div>
                        }
                        <div class="mat-tile__body">
                            <div class="mt-tile__title2" title="@item.Title">@item.Title</div>
                            <div class="mat-tile__meta">@item.Year</div>
                        </div>
                    </div>
                }
            </div>
        }

        <partial name="_Pagination" model="@(new PaginationModel
        {
            Id = "sharedPagination",
            Page = Model.PageNumber,
            PageSize = Model.PageSizeValue,
            TotalCount = Model.TotalCount,
            Query = new Dictionary<string, string?>
            {
                ["q"] = Model.Q,
                ["status"] = Model.StatusFilter,
            },
        })" />
    </main>

    <script src="~/matui/matui.js" asp-append-version="true"></script>
</body>
</html>
