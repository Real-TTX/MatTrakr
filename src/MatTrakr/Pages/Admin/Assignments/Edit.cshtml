@page "{id:long?}"
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Admin.Assignments.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neue Zuweisung" : "Zuweisung bearbeiten";
    ViewData["Width"] = "narrow";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Id" />

            <div class="mat-field">
                <label asp-for="ListId" class="mat-label">Liste <span class="mat-req">*</span></label>
                <select asp-for="ListId" class="mat-select">
                    <option value="0">– Liste wählen –</option>
                    @foreach (var list in Model.AllLists)
                    {
                        <option value="@list.Id">@list.Owner?.Username / @list.Name (@list.Type)</option>
                    }
                </select>
            </div>

            <div class="mat-field">
                <label asp-for="AssignedUserId" class="mat-label">Verwalter <span class="mat-req">*</span></label>
                <select asp-for="AssignedUserId" class="mat-select">
                    <option value="0">– Verwalter wählen –</option>
                    @foreach (var user in Model.Verwalter)
                    {
                        <option value="@user.Id">@user.DisplayName (@user.Role)</option>
                    }
                </select>
                <span class="mat-hint">Nur aktive Benutzer mit Rolle Verwalter oder Admin.</span>
            </div>

            <partial name="_FormActionsBar" model="@(new FormActionsModel
            {
                BackUrl = "/Admin/Assignments",
                DeleteHandler = Model.IsNew ? null : "Delete",
                DeleteConfirm = "Zuweisung wirklich löschen?",
            })" />
        </form>

        <partial name="_DeleteForm" model="@(new FormActionsModel
        {
            DeleteHandler = Model.IsNew ? null : "Delete",
            DeleteRouteValues = { ["id"] = Model.Id.ToString() },
        })" />
    </div>
</div>
