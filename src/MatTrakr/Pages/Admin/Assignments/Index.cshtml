@page
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Admin.Assignments.IndexModel
@{
    ViewData["Title"] = "Listen-Zuweisungen";
    ViewData["Description"] = "Weise Verwaltern fremde Listen zu, damit sie diese bearbeiten können.";
}

<partial name="_TableToolbar" model="@(new TableToolbarModel
{
    Id = "assignToolbar",
    SearchValue = Model.Q,
    SearchPlaceholder = "Liste, Verwalter oder Eigentümer …",
    SortOptions =
    {
        new ToolbarSortOption { Value = "list", Text = "Liste" },
        new ToolbarSortOption { Value = "verwalter", Text = "Verwalter" },
        new ToolbarSortOption { Value = "owner", Text = "Eigentümer" },
        new ToolbarSortOption { Value = "created", Text = "Neueste zuerst" },
    },
    SortValue = Model.Sort,
})" />

@if (Model.Assignments.Count == 0)
{
    <div class="mat-empty">
        <div class="mat-empty__icon">@Ui.Icon("users")</div>
        <p class="mat-empty__title">Keine Zuweisungen vorhanden.</p>
    </div>
}
else
{
    <div class="mat-table-wrap">
        <table class="mat-table">
            <thead>
                <tr>
                    <th>Liste</th>
                    <th>Eigentümer</th>
                    <th>Verwalter</th>
                    <th><span class="mat-sr-only">Aktion</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assignments)
                {
                    <tr data-row-href="/Admin/Assignments/Edit/@a.Id">
                        <td data-label="Liste">
                            <div class="mat-table__name"><span><a href="/Admin/Assignments/Edit/@a.Id">@a.List?.Name</a> <span class="mat-tag">@a.List?.Type</span></span></div>
                        </td>
                        <td data-label="Eigentümer">@a.List?.Owner?.DisplayName</td>
                        <td data-label="Verwalter">@a.AssignedUser?.DisplayName</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a href="/Admin/Assignments/Edit/@a.Id" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Bearbeiten" aria-label="Bearbeiten">@Ui.Icon("edit")</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_Pagination" model="@(new PaginationModel
{
    Id = "assignPagination",
    Page = Model.PageNumber,
    PageSize = Model.PageSizeValue,
    TotalCount = Model.TotalCount,
    Query = new Dictionary<string, string?> { ["q"] = Model.Q, ["sort"] = Model.Sort },
})" />

<div class="mat-actions">
    <a href="/Admin/Assignments/Edit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Neue Zuweisung</span></a>
</div>
