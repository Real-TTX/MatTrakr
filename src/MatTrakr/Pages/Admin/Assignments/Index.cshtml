@page
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Admin.Assignments.IndexModel
@{
    ViewData["Title"] = "Listen-Zuweisungen";
}

<h1 class="page-title"><i class="bi bi-person-check"></i>Listen-Zuweisungen</h1>
<p class="text-muted">
    Weise Verwaltern fremde Listen zu, damit sie diese bearbeiten können.
</p>

<partial name="_TableToolbar" model="@(new TableToolbarModel
{
    Id = "assignToolbar",
    SearchValue = Model.Q,
    SearchPlaceholder = "Liste, Verwalter oder Eigentümer …",
    SortOptions =
    {
        new ToolbarSortOption { Value = "list", Text = "Liste" },
        new ToolbarSortOption { Value = "verwalter", Text = "Verwalter" },
        new ToolbarSortOption { Value = "owner", Text = "Eigentümer" },
        new ToolbarSortOption { Value = "created", Text = "Neueste zuerst" },
    },
    SortValue = Model.Sort,
})" />

<div class="content-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Liste</th>
                    <th>Eigentümer</th>
                    <th>Verwalter</th>
                    <th class="text-end">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assignments)
                {
                    <tr>
                        <td>@a.List?.Name <span class="badge text-bg-light">@a.List?.Type</span></td>
                        <td>@a.List?.Owner?.DisplayName</td>
                        <td>@a.AssignedUser?.DisplayName</td>
                        <td class="text-end">
                            <a href="/Admin/Assignments/Edit/@a.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (Model.Assignments.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Keine Zuweisungen vorhanden.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new PaginationModel
{
    Id = "assignPagination",
    Page = Model.PageNumber,
    PageSize = Model.PageSizeValue,
    TotalCount = Model.TotalCount,
    Query = new Dictionary<string, string?> { ["q"] = Model.Q, ["sort"] = Model.Sort },
})" />

<div class="list-actions">
    <a href="/Admin/Assignments/Edit" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Neue Zuweisung
    </a>
</div>
