@page "/Admin/Backup"
@model MatTrakr.Pages.Admin.Backup.IndexModel
@{
    ViewData["Title"] = "Backup & Restore";
    ViewData["Width"] = "narrow";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__head">@Ui.Icon("download")<span class="mat-card__title">Backup herunterladen</span></div>
    <div class="mat-card__body mat-form">
        <p class="mat-muted">
            Lädt ein <code>.zip</code> mit der kompletten Datenbank (Listen, Einträge, hochgeladene
            Cover, Benutzer) <strong>und der Konfiguration</strong> (<code>config/settings.json</code>).
        </p>
        <div class="mat-alert mat-alert--warning" role="alert">
            @Ui.Icon("key")<span>Das Backup enthält die <strong>API-Keys</strong> (TMDb / Google Books)
            im Klartext – entsprechend sicher aufbewahren.</span>
        </div>
        <div class="mat-actions">
            <a href="/Admin/Backup?handler=Download" class="mat-btn mat-btn--primary">@Ui.Icon("download")<span>Backup herunterladen (.zip)</span></a>
        </div>
    </div>
</div>

<div class="mat-card">
    <div class="mat-card__head">@Ui.Icon("upload")<span class="mat-card__title">Wiederherstellen</span></div>
    <div class="mat-card__body">
        <form method="post" asp-page-handler="Restore" enctype="multipart/form-data" class="mat-form">
            <div class="mat-alert mat-alert--warning" role="alert">
                @Ui.Icon("alert")<span>Achtung: Die aktuelle Datenbank wird <strong>vollständig ersetzt</strong>. Eine
                automatische Sicherheitskopie der bisherigen Daten wird angelegt. Danach musst du
                dich neu anmelden.</span>
            </div>

            <div class="mat-field">
                <label for="backupFile" class="mat-label">Backup-Datei (.zip oder .db)</label>
                <input type="file" name="file" id="backupFile" class="mat-input"
                       accept=".zip,application/zip,.db,application/x-sqlite3" required />
                <span class="mat-hint">
                    Ein <code>.zip</code> stellt Datenbank <strong>und</strong> Konfiguration wieder her;
                    ältere <code>.db</code>-Backups werden weiterhin unterstützt (nur Datenbank).
                </span>
            </div>

            <div class="mat-actions">
                <button type="submit" class="mat-btn mat-btn--danger"
                        data-confirm="Die aktuelle Datenbank wirklich durch das Backup ersetzen?" data-confirm-ok="Wiederherstellen">
                    @Ui.Icon("upload")<span>Datenbank wiederherstellen</span>
                </button>
            </div>
        </form>
    </div>
</div>
