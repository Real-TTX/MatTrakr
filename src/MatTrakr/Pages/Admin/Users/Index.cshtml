@page
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Benutzer";
}

<partial name="_TableToolbar" model="@(new TableToolbarModel
{
    Id = "usersToolbar",
    SearchValue = Model.Q,
    SearchPlaceholder = "Benutzername oder Anzeigename …",
    Filters =
    {
        new ToolbarFilter
        {
            Name = "role", Label = "Rolle", Selected = Model.RoleFilter,
            Options =
            {
                ("", "Alle"),
                (nameof(UserRole.Admin), "Admin"),
                (nameof(UserRole.Verwalter), "Verwalter"),
                (nameof(UserRole.User), "User"),
            },
        },
        new ToolbarFilter
        {
            Name = "active", Label = "Status", Selected = Model.ActiveFilter,
            Options = { ("", "Alle"), ("1", "Aktiv"), ("0", "Inaktiv") },
        },
    },
    SortOptions =
    {
        new ToolbarSortOption { Value = "username", Text = "Benutzername ↑" },
        new ToolbarSortOption { Value = "username_desc", Text = "Benutzername ↓" },
        new ToolbarSortOption { Value = "role", Text = "Rolle" },
        new ToolbarSortOption { Value = "created", Text = "Neueste zuerst" },
    },
    SortValue = Model.Sort,
})" />

@if (Model.Users.Count == 0)
{
    <div class="mat-empty">
        <div class="mat-empty__icon">@Ui.Icon("users")</div>
        <p class="mat-empty__title">Keine Benutzer gefunden.</p>
    </div>
}
else
{
    <div class="mat-table-wrap">
        <table class="mat-table">
            <thead>
                <tr>
                    <th>Benutzername</th>
                    <th>Anzeigename</th>
                    <th>Rolle</th>
                    <th>Status</th>
                    <th><span class="mat-sr-only">Aktion</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr data-row-href="/Admin/Users/Edit/@user.Id">
                        <td data-label="Benutzername"><div class="mat-table__name"><a href="/Admin/Users/Edit/@user.Id">@user.Username</a></div></td>
                        <td data-label="Anzeigename">@user.DisplayName</td>
                        <td data-label="Rolle">
                            <span class="mat-pill @(user.Role switch
                                                    {
                                                        UserRole.Admin => "mat-pill--error",
                                                        UserRole.Verwalter => "mat-pill--warn",
                                                        _ => "mat-pill--plain",
                                                    })">@user.Role</span>
                        </td>
                        <td data-label="Status">
                            @if (user.IsActive)
                            {
                                <span class="mat-pill mat-pill--ok">Aktiv</span>
                            }
                            else
                            {
                                <span class="mat-pill mat-pill--plain">Inaktiv</span>
                            }
                        </td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a href="/Admin/Users/Edit/@user.Id" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Bearbeiten" aria-label="Bearbeiten">@Ui.Icon("edit")</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_Pagination" model="@(new PaginationModel
{
    Id = "usersPagination",
    Page = Model.PageNumber,
    PageSize = Model.PageSizeValue,
    TotalCount = Model.TotalCount,
    Query = new Dictionary<string, string?>
    {
        ["q"] = Model.Q,
        ["role"] = Model.RoleFilter,
        ["active"] = Model.ActiveFilter,
        ["sort"] = Model.Sort,
    },
})" />

<div class="mat-actions">
    <a href="/Admin/Users/Edit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Neuer Benutzer</span></a>
</div>
