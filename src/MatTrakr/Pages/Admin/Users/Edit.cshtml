@page "{id:long?}"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neuer Benutzer" : "Benutzer bearbeiten";
    ViewData["Width"] = "narrow";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Id" />

            <div class="mat-field">
                <label asp-for="Username" class="mat-label">Benutzername <span class="mat-req">*</span></label>
                <input asp-for="Username" class="mat-input" autocomplete="off" />
            </div>

            <div class="mat-field">
                <label asp-for="DisplayName" class="mat-label">Anzeigename</label>
                <input asp-for="DisplayName" class="mat-input" autocomplete="off" />
            </div>

            <div class="mat-field">
                <label asp-for="Role" class="mat-label">Rolle</label>
                <select asp-for="Role" class="mat-select">
                    <option value="@UserRole.User">User</option>
                    <option value="@UserRole.Verwalter">Verwalter</option>
                    <option value="@UserRole.Admin">Admin</option>
                </select>
            </div>

            <label class="mat-switch">
                <input asp-for="IsActive" type="checkbox" />
                <span class="mat-switch__track" aria-hidden="true"></span>
                <span>Aktiv</span>
            </label>

            <div class="mat-field">
                <label asp-for="Password" class="mat-label">
                    @(Model.IsNew ? "Initialpasswort *" : "Neues Passwort (leer = unverändert)")
                </label>
                <input asp-for="Password" type="password" class="mat-input" autocomplete="new-password" />
            </div>

            <label class="mat-check">
                <input asp-for="MustChangePassword" type="checkbox" />
                <span class="mat-check__text">Passwortänderung beim nächsten Login erzwingen</span>
            </label>

            @if (Model.IsNew)
            {
                <div class="mat-alert mat-alert--info" role="note">
                    @Ui.Icon("info")<span>Beim Anlegen werden automatisch die Listen <strong>Movies</strong>,
                    <strong>Series</strong> und <strong>Books</strong> erstellt.</span>
                </div>
            }

            <partial name="_FormActionsBar" model="@(new FormActionsModel
            {
                BackUrl = "/Admin/Users",
                DeleteHandler = Model.IsNew ? null : "Delete",
                DeleteConfirm = "Benutzer inklusive aller Listen wirklich löschen?",
            })" />
        </form>

        <partial name="_DeleteForm" model="@(new FormActionsModel
        {
            DeleteHandler = Model.IsNew ? null : "Delete",
            DeleteRouteValues = { ["id"] = Model.Id.ToString() },
        })" />
    </div>
</div>
