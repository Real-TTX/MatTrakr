@page
@model MatTrakr.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "Einstellungen";
    ViewData["Width"] = "narrow";
}

@if (!string.IsNullOrEmpty(Model.Success))
{
    <div class="mat-alert mat-alert--success" role="status">@Ui.Icon("check-circle")<span>@Model.Success</span></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<form method="post" class="mat-form">
    <div class="mat-card">
        <div class="mat-card__head">
            @Ui.Icon("play")<span class="mat-card__title">TMDb – Movies &amp; Series</span>
            @if (Model.TmdbConfigured)
            {
                <span class="mat-pill mat-pill--ok mt-push-end">Konfiguriert</span>
            }
            else
            {
                <span class="mat-pill mat-pill--warn mt-push-end">Nicht konfiguriert</span>
            }
        </div>
        <div class="mat-card__body mat-form">
            <p class="mat-muted">
                Erforderlich für die Film-/Serien-Suche. Kostenlosen Key erstellen unter
                <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener">themoviedb.org/settings/api</a>.
            </p>
            <div class="mat-field">
                <label asp-for="TmdbApiKey" class="mat-label">TMDb API-Key</label>
                <div class="mat-input-icon">
                    @Ui.Icon("key")
                    <input asp-for="TmdbApiKey" class="mat-input" autocomplete="off"
                           spellcheck="false" placeholder="z.B. 1a2b3c4d5e6f…" />
                </div>
            </div>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head">@Ui.Icon("book")<span class="mat-card__title">Google Books – Books</span></div>
        <div class="mat-card__body mat-form">
            <p class="mat-muted">
                Optional – die Buch-Suche funktioniert auch ohne Key
                (bei Bedarf Fallback auf Open Library). Ein eigener Key erhöht das Tages-Limit.
            </p>
            <div class="mat-field">
                <label asp-for="GoogleBooksApiKey" class="mat-label">Google Books API-Key (optional)</label>
                <div class="mat-input-icon">
                    @Ui.Icon("key")
                    <input asp-for="GoogleBooksApiKey" class="mat-input" autocomplete="off"
                           spellcheck="false" placeholder="leer lassen für anonymen Zugriff" />
                </div>
            </div>
        </div>
    </div>

    <div class="mat-btn-row mat-btn-row--plain">
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("check")<span>Speichern</span></button>
        <button type="submit" asp-page-handler="TestTmdb" class="mat-btn mat-btn--secondary">@Ui.Icon("plug")<span>Speichern &amp; TMDb testen</span></button>
        <a href="/" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>Zurück</span></a>
    </div>

    <p class="mat-hint">
        @Ui.Icon("info") Gespeichert wird in <code>data/config/settings.json</code> im Docker-Volume.
        Änderungen greifen sofort, ein Container-Neustart ist nicht nötig.
    </p>
</form>
