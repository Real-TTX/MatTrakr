@page "/Lists/{listId:long}/Items/{itemId:long}"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Lists.ItemModel
@{
    ViewData["Title"] = Model.Item.Title;
    var meta = string.IsNullOrEmpty(Model.Item.MetadataJson)
        ? null
        : System.Text.Json.JsonDocument.Parse(Model.Item.MetadataJson);
    string? subtitle = null;
    if (meta is not null && meta.RootElement.TryGetProperty("subtitle", out var st))
        subtitle = st.GetString();
    var badge = StatusDisplay.Badge(Model.Item, Model.List.Type);
}

<h1 class="page-title"><i class="bi bi-card-text"></i>@Model.Item.Title</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.Error
    </div>
}

<div class="content-card p-3">
    <div class="row g-4">
        <div class="col-12 col-md-auto">
            @if (!string.IsNullOrEmpty(Model.Item.CoverUrl))
            {
                <img src="@Model.Item.CoverUrl" alt="@Model.Item.Title" class="item-detail-cover" />
            }
            else
            {
                <div class="item-detail-cover item-detail-cover-placeholder">
                    <i class="bi bi-image"></i>
                </div>
            }
        </div>
        <div class="col">
            <dl class="row mb-3">
                <dt class="col-sm-3">Titel</dt>
                <dd class="col-sm-9">@Model.Item.Title</dd>

                @if (!string.IsNullOrEmpty(subtitle))
                {
                    <dt class="col-sm-3">@(Model.List.Type == MediaType.Books ? "Autor" : "Originaltitel")</dt>
                    <dd class="col-sm-9">@subtitle</dd>
                }

                @if (Model.Item.Year is not null)
                {
                    <dt class="col-sm-3">Jahr</dt>
                    <dd class="col-sm-9">@Model.Item.Year</dd>
                }

                @if (Model.List.Type == MediaType.Series && Model.Item.TotalSeasons is > 0)
                {
                    <dt class="col-sm-3">Staffeln</dt>
                    <dd class="col-sm-9">@Model.Item.WatchedSeasons von @Model.Item.TotalSeasons gesehen</dd>
                }

                @if (!string.IsNullOrEmpty(Model.Item.Overview))
                {
                    <dt class="col-sm-3">Beschreibung</dt>
                    <dd class="col-sm-9">@Model.Item.Overview</dd>
                }

                <dt class="col-sm-3">Quelle</dt>
                <dd class="col-sm-9">@Model.Item.Source</dd>
            </dl>

            @if (Model.CanEdit)
            {
                <form method="post">
                    <div style="max-width: 560px;">
                        @* 1. Status shortcuts — always, incl. Abgebrochen *@
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <div class="status-toggle" data-status-toggle>
                                <input type="radio" class="btn-check" name="Status" value="@ItemStatus.Open"
                                       id="st_open" autocomplete="off" checked="@(Model.Status == ItemStatus.Open)" />
                                <label class="btn btn-outline-primary status-btn" for="st_open">
                                    <i class="bi bi-hourglass me-1"></i>@Model.OpenWord
                                </label>

                                @if (Model.List.Type == MediaType.Series)
                                {
                                    <input type="radio" class="btn-check" name="Status" value="@ItemStatus.Partial"
                                           id="st_partial" autocomplete="off" checked="@(Model.Status == ItemStatus.Partial)" />
                                    <label class="btn btn-outline-primary status-btn" for="st_partial">
                                        <i class="bi bi-hourglass-split me-1"></i>@Model.PartialWord
                                    </label>
                                }

                                <input type="radio" class="btn-check" name="Status" value="@ItemStatus.Done"
                                       id="st_done" autocomplete="off" checked="@(Model.Status == ItemStatus.Done)" />
                                <label class="btn btn-outline-primary status-btn" for="st_done">
                                    <i class="bi bi-check-lg me-1"></i>@Model.DoneWord
                                </label>

                                <input type="radio" class="btn-check" name="Status" value="@ItemStatus.Abandoned"
                                       id="st_abandon" autocomplete="off" checked="@(Model.Status == ItemStatus.Abandoned)" />
                                <label class="btn btn-outline-danger status-btn status-btn--abandon" for="st_abandon">
                                    <i class="bi bi-x-circle me-1"></i>Abgebrochen
                                </label>
                            </div>
                        </div>

                        @* 2. Season picker — series with a known season count *@
                        @if (Model.UsesSeasons)
                        {
                            var total = Model.Item.TotalSeasons!.Value;
                            <div class="mb-3">
                                <label class="form-label d-block">Gesehene Staffeln</label>
                                <div class="season-picker" data-season-picker data-status-sync>
                                    <div class="season-picker-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-season-set="all">
                                            <i class="bi bi-check-all me-1"></i>Alle
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-season-set="half">
                                            <i class="bi bi-hourglass-split me-1"></i>Teilweise
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-season-set="none">
                                            <i class="bi bi-x-lg me-1"></i>Keine
                                        </button>
                                    </div>
                                    <div class="season-checks">
                                        @for (var n = 1; n <= total; n++)
                                        {
                                            <input class="btn-check" type="checkbox" name="Seasons" value="@n"
                                                   id="season_@n" autocomplete="off" checked="@Model.Seasons.Contains(n)" />
                                            <label class="btn btn-outline-primary season-btn" for="season_@n">
                                                <i class="bi bi-tv me-1"></i>Staffel @n
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <hr class="my-3" />

                        @* 3. Verschieben nach *@
                        <div class="mb-3">
                            <label asp-for="MoveToListId" class="form-label">
                                Verschieben nach <i class="bi bi-arrow-right-circle"></i>
                            </label>
                            <select asp-for="MoveToListId" class="form-select">
                                <option value="0">– nicht verschieben –</option>
                                @foreach (var target in Model.MoveTargets)
                                {
                                    <option value="@target.Id">@target.Name</option>
                                }
                            </select>
                            <div class="form-text">Nur Listen vom Typ @Model.List.Type.</div>
                        </div>

                        <hr class="my-3" />
                    </div>

                    @* 4. Save, Back … Delete *@
                    <partial name="_FormActionsBar" model="@(new FormActionsModel
                    {
                        BackUrl = $"/Lists/{Model.List.Id}",
                        DeleteHandler = "Delete",
                        DeleteConfirm = $"„{Model.Item.Title}“ wirklich löschen?",
                    })" />
                </form>

                <partial name="_DeleteForm" model="@(new FormActionsModel
                {
                    DeleteHandler = "Delete",
                })" />
            }
            else
            {
                <span class="badge @badge.Css me-2">
                    <i class="bi @badge.Icon me-1"></i>@badge.Text
                </span>
                <div class="list-actions">
                    <a href="/Lists/@Model.List.Id" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Zurück
                    </a>
                </div>
            }
        </div>
    </div>
</div>
