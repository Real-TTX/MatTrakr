@page "/Lists/{listId:long}/Items/{itemId:long}"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Lists.ItemModel
@{
    ViewData["Title"] = Model.Item.Title;
    var meta = string.IsNullOrEmpty(Model.Item.MetadataJson)
        ? null
        : System.Text.Json.JsonDocument.Parse(Model.Item.MetadataJson);
    string? subtitle = null;
    if (meta is not null && meta.RootElement.TryGetProperty("subtitle", out var st))
        subtitle = st.GetString();
    var badge = StatusDisplay.Badge(Model.Item, Model.List.Type);
}

<h1 class="page-title"><i class="bi bi-card-text"></i>@Model.Item.Title</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.Error
    </div>
}

<div class="content-card p-3">
    <div class="row g-4">
        <div class="col-12 col-md-auto">
            @if (!string.IsNullOrEmpty(Model.Item.CoverUrl))
            {
                <img src="@Model.Item.CoverUrl" alt="@Model.Item.Title" class="item-detail-cover" />
            }
            else
            {
                <div class="item-detail-cover item-detail-cover-placeholder">
                    <i class="bi bi-image"></i>
                </div>
            }
        </div>
        <div class="col">
            <dl class="row mb-3">
                <dt class="col-sm-3">Titel</dt>
                <dd class="col-sm-9">@Model.Item.Title</dd>

                @if (!string.IsNullOrEmpty(subtitle))
                {
                    <dt class="col-sm-3">@(Model.List.Type == MediaType.Books ? "Autor" : "Originaltitel")</dt>
                    <dd class="col-sm-9">@subtitle</dd>
                }

                @if (Model.Item.Year is not null)
                {
                    <dt class="col-sm-3">Jahr</dt>
                    <dd class="col-sm-9">@Model.Item.Year</dd>
                }

                @if (Model.List.Type == MediaType.Series && Model.Item.TotalSeasons is > 0)
                {
                    <dt class="col-sm-3">Staffeln</dt>
                    <dd class="col-sm-9">@Model.Item.WatchedSeasons von @Model.Item.TotalSeasons gesehen</dd>
                }

                @if (!string.IsNullOrEmpty(Model.Item.Overview))
                {
                    <dt class="col-sm-3">Beschreibung</dt>
                    <dd class="col-sm-9">@Model.Item.Overview</dd>
                }

                <dt class="col-sm-3">Quelle</dt>
                <dd class="col-sm-9">@Model.Item.Source</dd>
            </dl>

            @if (Model.CanEdit)
            {
                <form method="post">
                    <div class="row g-3 mb-2" style="max-width: 560px;">
                        <div class="col-12 col-sm-6">
                            @if (Model.UsesSeasons)
                            {
                                var total = Model.Item.TotalSeasons!.Value;
                                <label asp-for="WatchedSeasons" class="form-label">Gesehene Staffeln</label>
                                <div class="input-group season-stepper">
                                    <button type="button" class="btn btn-outline-secondary" data-season-step="-1" aria-label="Weniger">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <input asp-for="WatchedSeasons" type="number" min="0" max="@total"
                                           class="form-control text-center" />
                                    <span class="input-group-text">/ @total</span>
                                    <button type="button" class="btn btn-outline-secondary" data-season-step="1" aria-label="Mehr">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="form-text">
                                    Status wird automatisch gesetzt: 0 = @Model.OpenWord, alle = @Model.DoneWord,
                                    dazwischen = @Model.PartialWord.
                                </div>
                            }
                            else if (Model.List.Type == MediaType.Series)
                            {
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="@ItemStatus.Open">@Model.OpenWord</option>
                                    <option value="@ItemStatus.Partial">@Model.PartialWord</option>
                                    <option value="@ItemStatus.Done">@Model.DoneWord</option>
                                </select>
                            }
                            else
                            {
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="@ItemStatus.Open">@Model.OpenWord</option>
                                    <option value="@ItemStatus.Done">@Model.DoneWord</option>
                                </select>
                            }
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="MoveToListId" class="form-label">
                                Verschieben nach <i class="bi bi-arrow-right-circle"></i>
                            </label>
                            <select asp-for="MoveToListId" class="form-select">
                                <option value="0">– nicht verschieben –</option>
                                @foreach (var target in Model.MoveTargets)
                                {
                                    <option value="@target.Id">@target.Name</option>
                                }
                            </select>
                            <div class="form-text">Nur Listen vom Typ @Model.List.Type.</div>
                        </div>
                    </div>

                    <partial name="_FormActionsBar" model="@(new FormActionsModel
                    {
                        BackUrl = $"/Lists/{Model.List.Id}",
                        DeleteHandler = "Delete",
                        DeleteConfirm = $"„{Model.Item.Title}“ wirklich löschen?",
                    })" />
                </form>

                <partial name="_DeleteForm" model="@(new FormActionsModel
                {
                    DeleteHandler = "Delete",
                })" />
            }
            else
            {
                <span class="badge @badge.Css me-2">
                    <i class="bi @badge.Icon me-1"></i>@badge.Text
                </span>
                <div class="list-actions">
                    <a href="/Lists/@Model.List.Id" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Zurück
                    </a>
                </div>
            }
        </div>
    </div>
</div>
