@page "/Lists/{id:long}"
@using MatTrakr.Data
@using MatTrakr.Services
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Lists.DetailsModel
@{
    ViewData["Title"] = Model.List.Name;
    var typeIcon = Model.List.Type switch
    {
        MediaType.Movies => "film",
        MediaType.Series => "tv",
        MediaType.Books => "book",
        _ => "collection",
    };

    var statusOptions = new List<(string, string)> { ("", "Alle"), ("open", Model.OpenWord) };
    if (Model.List.Type == MediaType.Series) statusOptions.Add(("partial", "Teilweise"));
    statusOptions.Add(("done", Model.DoneWord));
    statusOptions.Add(("abandoned", "Abgebrochen"));
}

@if (Model.Access == ListAccess.ReadOnly)
{
    <div class="mat-chips"><span class="mat-pill mat-pill--plain">Nur Lesen</span></div>
}

<partial name="_TableToolbar" model="@(new TableToolbarModel
{
    Id = "itemsToolbar",
    SearchValue = Model.Q,
    SearchPlaceholder = "Titel suchen …",
    Filters =
    {
        new ToolbarFilter
        {
            Name = "status", Label = "Status", Selected = Model.StatusFilter,
            Options = statusOptions,
        },
    },
    SortOptions =
    {
        new ToolbarSortOption { Value = "title", Text = "Titel ↑" },
        new ToolbarSortOption { Value = "title_desc", Text = "Titel ↓" },
        new ToolbarSortOption { Value = "year", Text = "Jahr (neu zuerst)" },
        new ToolbarSortOption { Value = "added", Text = "Zuletzt hinzugefügt" },
    },
    SortValue = Model.Sort,
})" />

@if (Model.Items.Count == 0)
{
    <div class="mat-empty">
        <div class="mat-empty__icon">@Ui.Icon(typeIcon)</div>
        @if (Model.TotalCount == 0 && string.IsNullOrEmpty(Model.Q) && string.IsNullOrEmpty(Model.StatusFilter))
        {
            <p class="mat-empty__title">Diese Liste ist noch leer.</p>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Q) && Model.CanEdit)
        {
            <p class="mat-empty__title">„@Model.Q“ ist noch nicht in dieser Liste.</p>
            <a href="/Lists/@Model.List.Id/Add?q=@Uri.EscapeDataString(Model.Q)" class="mat-btn mat-btn--primary">@Ui.Icon("search")<span>„@Model.Q“ jetzt suchen &amp; hinzufügen</span></a>
        }
        else
        {
            <p class="mat-empty__title">Keine Einträge für die aktuelle Filterung.</p>
        }
    </div>
}
else
{
    <div class="mat-gallery mt-gallery">
        @foreach (var item in Model.Items)
        {
            var done = item.Status == ItemStatus.Done;
            var badge = StatusDisplay.Badge(item, Model.List.Type);
            var above = Model.StatusPosition == CardStatusPosition.Above;
            <a href="/Lists/@Model.List.Id/Items/@item.Id" class="mat-tile mt-tile @(done ? "is-done" : null)">
                @if (above)
                {
                    <div class="mt-statusbar mt-statusbar--above mt-statusbar--@badge.Key">@Ui.Icon(badge.Icon)<span>@badge.Text</span></div>
                }
                <div class="mat-tile__media mt-cover">
                    @if (!string.IsNullOrEmpty(item.CoverUrl))
                    {
                        <img src="@item.CoverUrl" alt="@item.Title" loading="lazy" />
                    }
                    else
                    {
                        @Ui.Icon(typeIcon)
                    }
                </div>
                @if (!above)
                {
                    <div class="mt-statusbar mt-statusbar--below mt-statusbar--@badge.Key">@Ui.Icon(badge.Icon)<span>@badge.Text</span></div>
                }
                <div class="mat-tile__body">
                    <div class="mt-tile__title2" title="@item.Title">@item.Title</div>
                    <div class="mat-tile__meta">@item.Year</div>
                    @if (Model.MyRatings.TryGetValue(item.Id, out var myStars) && myStars > 0)
                    {
                        <div class="mt-tile__stars" title="Meine Bewertung: @myStars/5">
                            @for (var s = 1; s <= 5; s++)
                            {
                                @Ui.Icon("star", s <= myStars ? null : "is-off")
                            }
                        </div>
                    }
                </div>
            </a>
        }
    </div>
}

<partial name="_Pagination" model="@(new PaginationModel
{
    Id = "itemsPagination",
    Page = Model.PageNumber,
    PageSize = Model.PageSizeValue,
    TotalCount = Model.TotalCount,
    Query = new Dictionary<string, string?>
    {
        ["q"] = Model.Q,
        ["status"] = Model.StatusFilter,
        ["sort"] = Model.Sort,
    },
})" />

@if (Model.CanEdit)
{
    <div class="mat-actions">
        <a href="/Lists/@Model.List.Id/Add" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Suchen &amp; hinzufügen</span></a>
        <a href="/Lists/@Model.List.Id/AddManual" class="mat-btn mat-btn--secondary">@Ui.Icon("edit")<span>Eigener Eintrag</span></a>
        @if (Model.Access == ListAccess.Owner)
        {
            <a href="/Lists/@Model.List.Id/Share" class="mat-btn mat-btn--secondary">@Ui.Icon("link")<span>Teilen</span></a>
            <a href="/Lists/Edit/@Model.List.Id" class="mat-btn mat-btn--secondary">@Ui.Icon("edit")<span>Liste bearbeiten</span></a>
        }
    </div>
}
