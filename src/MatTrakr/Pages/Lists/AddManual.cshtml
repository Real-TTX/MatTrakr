@page "/Lists/{id:long}/AddManual"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Lists.AddManualModel
@{
    ViewData["Title"] = "Eigener Eintrag";
    var subtitleLabel = Model.List.Type == MediaType.Books ? "Autor" : "Originaltitel";
    var kind = Model.List.Type switch
    {
        MediaType.Movies => "Film",
        MediaType.Series => "Serie",
        MediaType.Books => "Buch",
        _ => "Eintrag",
    };
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" enctype="multipart/form-data" class="mat-form">
            <div class="mat-field">
                <label asp-for="Title" class="mat-label">Titel <span class="mat-req">*</span></label>
                <input asp-for="Title" class="mat-input" autofocus />
                <span asp-validation-for="Title" class="mat-error"></span>
            </div>

            <div class="mat-form__grid">
                <div class="mat-field">
                    <label asp-for="Subtitle" class="mat-label">@subtitleLabel</label>
                    <input asp-for="Subtitle" class="mat-input" />
                </div>
                <div class="mat-field">
                    <label asp-for="Year" class="mat-label">Jahr</label>
                    <input asp-for="Year" type="number" class="mat-input" min="0" max="2999" />
                </div>
            </div>

            @if (Model.List.Type == MediaType.Series)
            {
                <div class="mat-field">
                    <label asp-for="TotalSeasons" class="mat-label">Anzahl Staffeln</label>
                    <input asp-for="TotalSeasons" type="number" class="mat-input" min="0" max="100" />
                    <span class="mat-hint">Für die Staffel-Auswahl. Leer lassen, wenn unbekannt.</span>
                </div>
            }

            <div class="mat-field">
                <label asp-for="Overview" class="mat-label">Beschreibung</label>
                <textarea asp-for="Overview" class="mat-textarea" rows="3"></textarea>
            </div>

            <hr />

            <div class="mat-field">
                <span class="mat-label">Cover</span>
                <div class="cover-editor">
                    <div class="cover-editor-preview">
                        <img id="coverPreview" alt="Cover-Vorschau" hidden />
                        <div id="coverPlaceholder" class="cover-ph">@Ui.Icon("image")</div>
                    </div>

                    <div class="cover-editor-controls">
                        @if (Model.CoverSearchAvailable)
                        {
                            <div class="mat-input-group">
                                <span class="mat-input-addon">@Ui.Icon("search")</span>
                                <input type="text" id="coverSearchInput" class="mat-input"
                                       placeholder="Cover suchen (Titel) …" autocomplete="off" />
                                <button type="button" id="coverSearchBtn" class="mat-btn mat-btn--secondary">Suchen</button>
                            </div>
                            <div id="coverSearchStatus" class="mat-hint"></div>
                            <div id="coverSearchResults" class="cover-search-results"></div>
                        }
                        else
                        {
                            <p class="mat-hint">@Ui.Icon("info") Cover-Suche für Movies/Series braucht einen TMDb-Key
                                (Administration → Einstellungen). Du kannst trotzdem ein Bild hochladen oder eine URL einfügen.</p>
                        }

                        <label for="coverFileInput" class="mat-label mat-mt-3">… oder Bild hochladen (zuschneidbar)</label>
                        <input asp-for="CoverFile" type="file" id="coverFileInput" class="mat-input" accept="image/*" />

                        <details class="mat-mt-2">
                            <summary class="mat-muted">Bild-URL einfügen</summary>
                            <input asp-for="CoverUrl" id="coverUrlInput" class="mat-input mat-mt-2" placeholder="https://…" />
                        </details>

                        <input asp-for="CroppedImage" id="CroppedImage" type="hidden" />
                    </div>
                </div>
            </div>

            <partial name="_FormActionsBar" model="@(new FormActionsModel
            {
                SaveText = "Hinzufügen",
                SaveIcon = "plus",
                BackUrl = $"/Lists/{Model.List.Id}",
            })" />
        </form>
    </div>
</div>

@* Crop dialog *@
<div id="cropOverlay" class="crop-overlay" hidden>
    <div class="crop-box">
        <h2 class="mat-mb-2">Cover zuschneiden</h2>
        <canvas id="cropCanvas" width="240" height="360"></canvas>
        <label class="mat-label mat-mt-2" for="cropZoom">@Ui.Icon("search") Zoom</label>
        <input type="range" id="cropZoom" class="mat-range" min="1" max="3" step="0.01" value="1" />
        <p class="mat-hint">Ziehen zum Verschieben, Regler zum Zoomen.</p>
        <div class="mat-actions mat-mt-2">
            <button type="button" id="cropApply" class="mat-btn mat-btn--primary mat-btn--sm">@Ui.Icon("check")<span>Übernehmen</span></button>
            <button type="button" id="cropCancel" class="mat-btn mat-btn--secondary mat-btn--sm">@Ui.Icon("x")<span>Abbrechen</span></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const listId = @Model.List.Id;
    const preview = document.getElementById('coverPreview');
    const placeholder = document.getElementById('coverPlaceholder');
    const urlInput = document.getElementById('coverUrlInput');
    const croppedInput = document.getElementById('CroppedImage');
    const fileInput = document.getElementById('coverFileInput');

    function showPreview(src) {
        if (src) { preview.src = src; preview.hidden = false; placeholder.hidden = true; }
        else { preview.removeAttribute('src'); preview.hidden = true; placeholder.hidden = false; }
    }
    function pickUrl(url) { croppedInput.value = ''; fileInput.value = ''; if (urlInput) urlInput.value = url; showPreview(url); }
    function pickCropped(dataUrl) { if (urlInput) urlInput.value = ''; fileInput.value = ''; croppedInput.value = dataUrl; showPreview(dataUrl); }

    // Restore preview after a validation re-render
    if (croppedInput.value) showPreview(croppedInput.value);
    else if (urlInput && urlInput.value) showPreview(urlInput.value);

    if (urlInput) urlInput.addEventListener('input', () => { croppedInput.value = ''; showPreview(urlInput.value.trim()); });

    // --- Cover search ---
    const searchInput = document.getElementById('coverSearchInput');
    const searchBtn = document.getElementById('coverSearchBtn');
    const searchStatus = document.getElementById('coverSearchStatus');
    const searchResults = document.getElementById('coverSearchResults');
    let controller = null;

    async function doSearch() {
        const q = searchInput.value.trim();
        if (q.length < 2) { searchResults.innerHTML = ''; searchStatus.textContent = ''; return; }
        if (controller) controller.abort();
        controller = new AbortController();
        searchStatus.textContent = 'Suche läuft …';
        try {
            const res = await fetch(`/Lists/${listId}/AddManual?handler=CoverSearch&q=${encodeURIComponent(q)}`, { signal: controller.signal });
            const data = await res.json();
            const covers = data.covers || [];
            searchResults.innerHTML = '';
            searchStatus.textContent = covers.length ? `${covers.length} Treffer – zum Wählen anklicken` : 'Keine Cover gefunden.';
            for (const c of covers) {
                const b = document.createElement('button');
                b.type = 'button'; b.className = 'cover-hit';
                b.title = c.title + (c.year ? ` (${c.year})` : '');
                b.innerHTML = `<img src="${c.coverUrl}" alt="" loading="lazy">`;
                b.addEventListener('click', () => pickUrl(c.coverUrl));
                searchResults.appendChild(b);
            }
        } catch (e) { if (e.name !== 'AbortError') searchStatus.textContent = 'Suche fehlgeschlagen.'; }
    }
    if (searchBtn) searchBtn.addEventListener('click', doSearch);
    if (searchInput) searchInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } });

    // --- Cropper (2:3) ---
    const overlay = document.getElementById('cropOverlay');
    const canvas = document.getElementById('cropCanvas');
    const ctx = canvas.getContext('2d');
    const zoom = document.getElementById('cropZoom');
    const Ws = canvas.width, Hs = canvas.height;
    let img = null, base = 1, tx = 0, ty = 0, dragging = false, lastX = 0, lastY = 0;

    function draw() {
        const s = base * parseFloat(zoom.value);
        const dw = img.width * s, dh = img.height * s;
        tx = Math.min(0, Math.max(Ws - dw, tx));
        ty = Math.min(0, Math.max(Hs - dh, ty));
        ctx.clearRect(0, 0, Ws, Hs);
        ctx.drawImage(img, tx, ty, dw, dh);
    }

    fileInput.addEventListener('change', () => {
        const f = fileInput.files && fileInput.files[0];
        if (!f || !f.type.startsWith('image/')) return;
        const url = URL.createObjectURL(f);
        img = new Image();
        img.onload = () => {
            base = Math.max(Ws / img.width, Hs / img.height);
            zoom.value = '1';
            const s = base; tx = (Ws - img.width * s) / 2; ty = (Hs - img.height * s) / 2;
            draw();
            overlay.hidden = false;
            URL.revokeObjectURL(url);
        };
        img.src = url;
    });
    zoom.addEventListener('input', () => { if (img) draw(); });
    canvas.addEventListener('pointerdown', e => { dragging = true; lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); });
    canvas.addEventListener('pointermove', e => { if (!dragging || !img) return; tx += e.clientX - lastX; ty += e.clientY - lastY; lastX = e.clientX; lastY = e.clientY; draw(); });
    canvas.addEventListener('pointerup', () => { dragging = false; });
    document.getElementById('cropCancel').addEventListener('click', () => { overlay.hidden = true; fileInput.value = ''; });
    document.getElementById('cropApply').addEventListener('click', () => {
        const outW = 500, outH = 750, f = outW / Ws;
        const out = document.createElement('canvas'); out.width = outW; out.height = outH;
        const s = base * parseFloat(zoom.value);
        out.getContext('2d').drawImage(img, tx * f, ty * f, img.width * s * f, img.height * s * f);
        pickCropped(out.toDataURL('image/jpeg', 0.9));
        overlay.hidden = true;
    });
})();
</script>
}
