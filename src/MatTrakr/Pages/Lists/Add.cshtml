@page "/Lists/{id:long}/Add"
@using MatTrakr.Data
@model MatTrakr.Pages.Lists.AddModel
@{
    ViewData["Title"] = $"Hinzufügen zu „{Model.List.Name}“";
    var searchPlaceholder = Model.List.Type switch
    {
        MediaType.Movies => "Film suchen …",
        MediaType.Series => "Serie suchen …",
        MediaType.Books => "Buch suchen …",
        _ => "Suchen …",
    };
}

@if (!string.IsNullOrEmpty(Model.Warning))
{
    <div class="mat-alert mat-alert--warning" role="alert">@Ui.Icon("alert")<span>@Model.Warning</span></div>
}

<div class="mat-input-icon">
    @Ui.Icon("search")
    <input type="search" class="mat-input mat-input--lg" id="mediaSearchInput"
           placeholder="@searchPlaceholder" autocomplete="off" autofocus
           value="@Model.InitialQuery"
           @(Model.SearchAvailable ? null : "disabled") />
</div>

<div id="searchStatus" class="mat-muted mat-d-none"></div>
<div id="searchResults" class="search-results"></div>

<div class="mat-actions">
    <a href="/Lists/@Model.List.Id/AddManual" class="mat-btn mat-btn--secondary">@Ui.Icon("edit")<span>Eigenen Eintrag anlegen</span></a>
    <a href="/Lists/@Model.List.Id" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>Zurück zur Liste</span></a>
</div>

@section Scripts {
<script>
(function () {
    const input = document.getElementById('mediaSearchInput');
    const resultsEl = document.getElementById('searchResults');
    const statusEl = document.getElementById('searchStatus');
    const listId = @Model.List.Id;
    const token = '@Html.Raw(Xsrf.GetAndStoreTokens(HttpContext).RequestToken)';

    const icon = (name) => `<svg class="mat-icon" aria-hidden="true" focusable="false"><use href="#mat-i-${name}"></use></svg>`;

    let timer = null;
    let controller = null;

    input.addEventListener('input', function () {
        clearTimeout(timer);
        const q = input.value.trim();
        if (q.length < 2) {
            resultsEl.innerHTML = '';
            statusEl.classList.add('mat-d-none');
            return;
        }
        timer = setTimeout(() => search(q), 350);
    });

    const initialQuery = input.value.trim();
    if (initialQuery.length >= 2) {
        input.focus();
        search(initialQuery);
    }

    async function search(q) {
        if (controller) controller.abort();
        controller = new AbortController();

        statusEl.textContent = 'Suche läuft …';
        statusEl.classList.remove('mat-d-none');

        try {
            const res = await fetch(`/Lists/${listId}/Add?handler=Search&q=${encodeURIComponent(q)}`,
                { signal: controller.signal });
            if (!res.ok) throw new Error(res.status);
            const hits = await res.json();
            render(hits);
            statusEl.textContent = hits.length === 0 ? 'Keine Treffer.' : `${hits.length} Treffer`;
        } catch (e) {
            if (e.name !== 'AbortError') {
                statusEl.textContent = 'Suche fehlgeschlagen.';
            }
        }
    }

    function render(hits) {
        resultsEl.innerHTML = '';
        for (const hit of hits) {
            const card = document.createElement('div');
            card.className = 'search-hit' + (hit.alreadyAdded ? ' is-added' : '');

            const cover = hit.coverUrl
                ? `<img src="${escapeHtml(hit.coverUrl)}" alt="" class="search-hit-cover" loading="lazy">`
                : `<div class="search-hit-cover search-hit-cover-placeholder">${icon('image')}</div>`;

            card.innerHTML = `
                ${cover}
                <div class="search-hit-body">
                    <div class="search-hit-title">${escapeHtml(hit.title)}${hit.year ? ` <span class="mat-muted">(${hit.year})</span>` : ''}</div>
                    ${hit.subtitle ? `<div class="search-hit-subtitle">${escapeHtml(hit.subtitle)}</div>` : ''}
                    ${hit.overview ? `<div class="search-hit-overview">${escapeHtml(hit.overview)}</div>` : ''}
                </div>
                <div class="search-hit-action"></div>`;

            renderAction(card.querySelector('.search-hit-action'), hit);
            resultsEl.appendChild(card);
        }
    }

    function renderAction(action, hit) {
        action.innerHTML = '';
        if (hit.alreadyAdded) {
            const open = document.createElement('a');
            open.className = 'mat-btn mat-btn--secondary mat-btn--sm';
            open.href = `/Lists/${listId}/Items/${hit.itemId}`;
            open.title = 'Öffnen';
            open.setAttribute('aria-label', 'Öffnen');
            open.innerHTML = icon('external');

            const rm = document.createElement('button');
            rm.type = 'button';
            rm.className = 'mat-btn mat-btn--danger mat-btn--sm';
            rm.innerHTML = icon('trash') + '<span>Entfernen</span>';
            rm.addEventListener('click', () => remove(hit, action, rm));

            action.appendChild(open);
            action.appendChild(rm);
        } else {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'mat-btn mat-btn--primary mat-btn--sm';
            btn.innerHTML = icon('plus') + '<span>Hinzufügen</span>';
            btn.addEventListener('click', () => add(hit, action, btn));
            action.appendChild(btn);
        }
    }

    async function add(hit, action, btn) {
        btn.disabled = true;
        btn.classList.add('is-loading');

        const form = new URLSearchParams();
        form.set('externalId', hit.externalId);
        form.set('title', hit.title);
        if (hit.year) form.set('year', hit.year);
        if (hit.coverUrl) form.set('coverUrl', hit.coverUrl);
        if (hit.overview) form.set('overview', hit.overview);
        if (hit.subtitle) form.set('subtitle', hit.subtitle);

        try {
            const res = await fetch(`/Lists/${listId}/Add?handler=Add`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                },
                body: form.toString(),
            });
            if (!res.ok) throw new Error(res.status);
            const data = await res.json();
            hit.alreadyAdded = true;
            hit.itemId = data.itemId;
            action.closest('.search-hit')?.classList.add('is-added');
            renderAction(action, hit);
        } catch {
            btn.disabled = false;
            btn.classList.remove('is-loading');
            MatUi.toast('Hinzufügen fehlgeschlagen.', { tone: 'danger' });
        }
    }

    async function remove(hit, action, rm) {
        rm.disabled = true;
        rm.classList.add('is-loading');

        const form = new URLSearchParams();
        form.set('externalId', hit.externalId);

        try {
            const res = await fetch(`/Lists/${listId}/Add?handler=Remove`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                },
                body: form.toString(),
            });
            if (!res.ok) throw new Error(res.status);
            hit.alreadyAdded = false;
            hit.itemId = null;
            action.closest('.search-hit')?.classList.remove('is-added');
            renderAction(action, hit);
        } catch {
            rm.disabled = false;
            rm.classList.remove('is-loading');
            MatUi.toast('Entfernen fehlgeschlagen.', { tone: 'danger' });
        }
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        })[c]);
    }
})();
</script>
}
