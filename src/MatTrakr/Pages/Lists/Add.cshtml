@page "/Lists/{id:long}/Add"
@using MatTrakr.Data
@model MatTrakr.Pages.Lists.AddModel
@{
    ViewData["Title"] = $"Hinzufügen · {Model.List.Name}";
    var searchPlaceholder = Model.List.Type switch
    {
        MediaType.Movies => "Film suchen …",
        MediaType.Series => "Serie suchen …",
        MediaType.Books => "Buch suchen …",
        _ => "Suchen …",
    };
}

<h1 class="page-title"><i class="bi bi-plus-circle"></i>Hinzufügen zu „@Model.List.Name“</h1>

@if (!string.IsNullOrEmpty(Model.Warning))
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.Warning
    </div>
}

<div class="input-group input-group-lg mb-3">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input type="search" class="form-control" id="mediaSearchInput"
           placeholder="@searchPlaceholder" autocomplete="off" autofocus
           value="@Model.InitialQuery"
           @(Model.SearchAvailable ? null : "disabled") />
</div>

<div id="searchStatus" class="text-muted small mb-2 d-none"></div>
<div id="searchResults" class="search-results"></div>

<div class="list-actions">
    <a href="/Lists/@Model.List.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Zurück zur Liste
    </a>
</div>

@section Scripts {
<script>
(function () {
    const input = document.getElementById('mediaSearchInput');
    const resultsEl = document.getElementById('searchResults');
    const statusEl = document.getElementById('searchStatus');
    const listId = @Model.List.Id;
    const token = '@Html.Raw(Xsrf.GetAndStoreTokens(HttpContext).RequestToken)';

    let timer = null;
    let controller = null;

    input.addEventListener('input', function () {
        clearTimeout(timer);
        const q = input.value.trim();
        if (q.length < 2) {
            resultsEl.innerHTML = '';
            statusEl.classList.add('d-none');
            return;
        }
        timer = setTimeout(() => search(q), 350);
    });

    // Pre-filled term (e.g. handed over from an empty list search): run it now.
    const initialQuery = input.value.trim();
    if (initialQuery.length >= 2) {
        input.focus();
        search(initialQuery);
    }

    async function search(q) {
        if (controller) controller.abort();
        controller = new AbortController();

        statusEl.textContent = 'Suche läuft …';
        statusEl.classList.remove('d-none');

        try {
            const res = await fetch(`/Lists/${listId}/Add?handler=Search&q=${encodeURIComponent(q)}`,
                { signal: controller.signal });
            if (!res.ok) throw new Error(res.status);
            const hits = await res.json();
            render(hits);
            statusEl.textContent = hits.length === 0 ? 'Keine Treffer.' : `${hits.length} Treffer`;
        } catch (e) {
            if (e.name !== 'AbortError') {
                statusEl.textContent = 'Suche fehlgeschlagen.';
            }
        }
    }

    function render(hits) {
        resultsEl.innerHTML = '';
        for (const hit of hits) {
            const card = document.createElement('div');
            card.className = 'search-hit' + (hit.alreadyAdded ? ' is-added' : '');

            const cover = hit.coverUrl
                ? `<img src="${escapeHtml(hit.coverUrl)}" alt="" class="search-hit-cover" loading="lazy">`
                : `<div class="search-hit-cover search-hit-cover-placeholder"><i class="bi bi-image"></i></div>`;

            card.innerHTML = `
                ${cover}
                <div class="search-hit-body">
                    <div class="search-hit-title">${escapeHtml(hit.title)}${hit.year ? ` <span class="text-muted">(${hit.year})</span>` : ''}</div>
                    ${hit.subtitle ? `<div class="search-hit-subtitle">${escapeHtml(hit.subtitle)}</div>` : ''}
                    ${hit.overview ? `<div class="search-hit-overview">${escapeHtml(hit.overview)}</div>` : ''}
                </div>
                <div class="search-hit-action"></div>`;

            renderAction(card.querySelector('.search-hit-action'), hit);
            resultsEl.appendChild(card);
        }
    }

    // Renders the action area: "Hinzufügen", or (when in the list) "Öffnen" + "Entfernen".
    function renderAction(action, hit) {
        action.innerHTML = '';
        if (hit.alreadyAdded) {
            const open = document.createElement('a');
            open.className = 'btn btn-outline-secondary btn-sm search-hit-open';
            open.href = `/Lists/${listId}/Items/${hit.itemId}`;
            open.title = 'Öffnen';
            open.setAttribute('aria-label', 'Öffnen');
            open.innerHTML = '<i class="bi bi-box-arrow-up-right"></i>';

            const rm = document.createElement('button');
            rm.type = 'button';
            rm.className = 'btn btn-outline-danger btn-sm';
            rm.innerHTML = '<i class="bi bi-trash me-1"></i>Entfernen';
            rm.addEventListener('click', () => remove(hit, action, rm));

            action.appendChild(open);
            action.appendChild(rm);
        } else {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-primary btn-sm';
            btn.innerHTML = '<i class="bi bi-plus-lg me-1"></i>Hinzufügen';
            btn.addEventListener('click', () => add(hit, action, btn));
            action.appendChild(btn);
        }
    }

    async function add(hit, action, btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        const form = new URLSearchParams();
        form.set('externalId', hit.externalId);
        form.set('title', hit.title);
        if (hit.year) form.set('year', hit.year);
        if (hit.coverUrl) form.set('coverUrl', hit.coverUrl);
        if (hit.overview) form.set('overview', hit.overview);
        if (hit.subtitle) form.set('subtitle', hit.subtitle);

        try {
            const res = await fetch(`/Lists/${listId}/Add?handler=Add`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                },
                body: form.toString(),
            });
            if (!res.ok) throw new Error(res.status);
            const data = await res.json();
            hit.alreadyAdded = true;
            hit.itemId = data.itemId;
            action.closest('.search-hit')?.classList.add('is-added');
            renderAction(action, hit);
        } catch {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-plus-lg me-1"></i>Hinzufügen';
            alert('Hinzufügen fehlgeschlagen.');
        }
    }

    async function remove(hit, action, rm) {
        rm.disabled = true;
        rm.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        const form = new URLSearchParams();
        form.set('externalId', hit.externalId);

        try {
            const res = await fetch(`/Lists/${listId}/Add?handler=Remove`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                },
                body: form.toString(),
            });
            if (!res.ok) throw new Error(res.status);
            hit.alreadyAdded = false;
            hit.itemId = null;
            action.closest('.search-hit')?.classList.remove('is-added');
            renderAction(action, hit);
        } catch {
            rm.disabled = false;
            rm.innerHTML = '<i class="bi bi-trash me-1"></i>Entfernen';
            alert('Entfernen fehlgeschlagen.');
        }
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        })[c]);
    }
})();
</script>
}
