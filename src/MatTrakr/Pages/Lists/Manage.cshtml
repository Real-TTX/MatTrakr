@page "/Lists/Manage"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Lists.ManageModel
@{
    ViewData["Title"] = "Listen verwalten";

    string TypeIcon(MediaType t) => t switch
    {
        MediaType.Movies => "film",
        MediaType.Series => "tv",
        MediaType.Books => "book",
        _ => "collection",
    };
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<partial name="_TableToolbar" model="@(new TableToolbarModel
{
    Id = "listsToolbar",
    SearchValue = Model.Q,
    SearchPlaceholder = "Liste suchen …",
    Filters =
    {
        new ToolbarFilter
        {
            Name = "type", Label = "Typ", Selected = Model.TypeFilter,
            Options =
            {
                ("", "Alle"),
                (nameof(MediaType.Movies), "Movies"),
                (nameof(MediaType.Series), "Series"),
                (nameof(MediaType.Books), "Books"),
            },
        },
    },
    SortOptions =
    {
        new ToolbarSortOption { Value = "order", Text = "Reihenfolge (Menü)" },
        new ToolbarSortOption { Value = "name", Text = "Name ↑" },
        new ToolbarSortOption { Value = "name_desc", Text = "Name ↓" },
        new ToolbarSortOption { Value = "type", Text = "Typ" },
    },
    SortValue = Model.Sort,
})" />

@if (Model.Rows.Count > 0 && !Model.CanReorder)
{
    <p class="mat-muted">@Ui.Icon("info") Wähle Sortierung „Reihenfolge (Menü)" (ohne Filter/Suche), um die Reihenfolge per Pfeilen anzupassen.</p>
}

@if (Model.Rows.Count == 0)
{
    <div class="mat-empty">
        <div class="mat-empty__icon">@Ui.Icon("collection")</div>
        <p class="mat-empty__title">Keine Listen gefunden.</p>
    </div>
}
else
{
    <div class="mat-table-wrap">
        <table class="mat-table">
            <thead>
                <tr>
                    @if (Model.CanReorder)
                    {
                        <th>Reihenfolge</th>
                    }
                    <th>Pin</th>
                    <th>Name</th>
                    <th class="mat-hide-sm">Typ</th>
                    <th class="mat-num">Einträge</th>
                    <th><span class="mat-sr-only">Aktionen</span></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    <tr>
                        @if (Model.CanReorder)
                        {
                            <td data-label="Reihenfolge" class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <form method="post" asp-page-handler="Move">
                                        <input type="hidden" name="id" value="@row.List.Id" />
                                        <input type="hidden" name="dir" value="up" />
                                        <input type="hidden" name="sort" value="@Model.Sort" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Nach oben" aria-label="Nach oben" @(i == 0 ? "disabled" : null)>@Ui.Icon("arrow-up")</button>
                                    </form>
                                    <form method="post" asp-page-handler="Move">
                                        <input type="hidden" name="id" value="@row.List.Id" />
                                        <input type="hidden" name="dir" value="down" />
                                        <input type="hidden" name="sort" value="@Model.Sort" />
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Nach unten" aria-label="Nach unten" @(i == Model.Rows.Count - 1 ? "disabled" : null)>@Ui.Icon("arrow-down")</button>
                                    </form>
                                </div>
                            </td>
                        }
                        <td data-label="Pin">
                            <form method="post" asp-page-handler="ToggleFavorite">
                                <input type="hidden" name="id" value="@row.List.Id" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <input type="hidden" name="type" value="@Model.TypeFilter" />
                                <input type="hidden" name="sort" value="@Model.Sort" />
                                <button type="submit" class="mt-list-pin @(row.List.IsFavorite ? "is-on" : null)"
                                        title="@(row.List.IsFavorite ? "In Seitenleiste angepinnt – klicken zum Entfernen" : "An Seitenleiste anpinnen")"
                                        aria-label="@(row.List.IsFavorite ? "Pin entfernen" : "Anpinnen")">@Ui.Icon("star")</button>
                            </form>
                        </td>
                        <td data-label="Name">
                            <a href="/Lists/@row.List.Id" class="mat-table__name">@Ui.Icon(TypeIcon(row.List.Type))<span>@row.List.Name</span></a>
                        </td>
                        <td data-label="Typ" class="mat-hide-sm">@row.List.Type</td>
                        <td data-label="Einträge" class="mat-num">@row.Done / @row.Total</td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a href="/Lists/Edit/@row.List.Id" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" title="Bearbeiten" aria-label="Bearbeiten">@Ui.Icon("edit")</a>
                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="id" value="@row.List.Id" />
                                    <input type="hidden" name="q" value="@Model.Q" />
                                    <input type="hidden" name="type" value="@Model.TypeFilter" />
                                    <input type="hidden" name="sort" value="@Model.Sort" />
                                    <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" title="Löschen" aria-label="Löschen"
                                            data-confirm="„@row.List.Name“ inklusive aller Einträge wirklich löschen?" data-confirm-ok="Löschen">@Ui.Icon("trash")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mat-actions">
    <a href="/Lists/Edit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Neue Liste</span></a>
    <a href="/" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>Zurück</span></a>
</div>
