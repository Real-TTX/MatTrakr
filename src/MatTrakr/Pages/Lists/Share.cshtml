@page "/Lists/{id:long}/Share"
@using MatTrakr.Data
@model MatTrakr.Pages.Lists.ShareModel
@{
    ViewData["Title"] = $"„{Model.List.Name}“ teilen";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-6">
        <div class="mat-card">
            <div class="mat-card__head">@Ui.Icon("users")<span class="mat-card__title">Mit Benutzern teilen</span></div>
            <div class="mat-card__body mat-form">
                @if (Model.UserShares.Count > 0)
                {
                    <div class="mat-table-wrap">
                        <table class="mat-table">
                            <thead>
                                <tr><th>Benutzer</th><th>Berechtigung</th><th><span class="mat-sr-only">Aktion</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var share in Model.UserShares)
                                {
                                    <tr>
                                        <td data-label="Benutzer">@share.SharedWithUser?.DisplayName</td>
                                        <td data-label="Berechtigung">
                                            <span class="mat-pill @(share.Permission == SharePermission.Edit ? "mat-pill--warn" : "mat-pill--plain")">
                                                @(share.Permission == SharePermission.Edit ? "Bearbeiten" : "Nur Lesen")
                                            </span>
                                        </td>
                                        <td class="mat-table__cell-actions">
                                            <form method="post" asp-page-handler="RemoveUser" asp-route-id="@Model.List.Id" asp-route-shareId="@share.Id"
                                                  data-confirm="Freigabe wirklich entfernen?" data-confirm-ok="Entfernen">
                                                <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" aria-label="Entfernen">@Ui.Icon("x")</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="mat-muted">Noch mit niemandem geteilt.</p>
                }

                @if (Model.ShareCandidates.Count > 0)
                {
                    <form method="post" asp-page-handler="AddUser" asp-route-id="@Model.List.Id" class="mat-form">
                        <div class="mat-field">
                            <label asp-for="ShareWithUserId" class="mat-label">Benutzer</label>
                            <select asp-for="ShareWithUserId" class="mat-select">
                                <option value="0">– wählen –</option>
                                @foreach (var user in Model.ShareCandidates)
                                {
                                    <option value="@user.Id">@user.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="mat-field">
                            <label asp-for="Permission" class="mat-label">Berechtigung</label>
                            <select asp-for="Permission" class="mat-select">
                                <option value="@SharePermission.ReadOnly">Nur Lesen</option>
                                <option value="@SharePermission.Edit">Bearbeiten</option>
                            </select>
                        </div>
                        <div class="mat-actions">
                            <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Teilen</span></button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="mat-muted">Keine weiteren Benutzer verfügbar.</p>
                }
            </div>
        </div>
    </div>

    <div class="mat-col-12 mat-col-lg-6">
        <div class="mat-card">
            <div class="mat-card__head">@Ui.Icon("link")<span class="mat-card__title">Öffentlicher Link</span></div>
            <div class="mat-card__body mat-form">
                <p class="mat-muted">Jeder mit diesem Link kann die Liste ansehen (nur lesen) – auch ohne Anmeldung.</p>

                @if (Model.PublicShare is not null)
                {
                    var url = $"{Request.Scheme}://{Request.Host}/Shared/{Model.PublicShare.Token}";
                    <div class="mat-input-group">
                        <input type="text" class="mat-input" value="@url" readonly id="publicLinkInput" />
                        <button type="button" class="mat-btn mat-btn--secondary" data-copy="#publicLinkInput" aria-label="Kopieren">@Ui.Icon("copy")</button>
                    </div>
                    <form method="post" asp-page-handler="RevokeLink" asp-route-id="@Model.List.Id" data-confirm="Öffentlichen Link wirklich widerrufen?" data-confirm-ok="Widerrufen">
                        <div class="mat-actions">
                            <button type="submit" class="mat-btn mat-btn--danger">@Ui.Icon("x-circle")<span>Link widerrufen</span></button>
                        </div>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="CreateLink" asp-route-id="@Model.List.Id">
                        <div class="mat-actions">
                            <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("link")<span>Link erstellen</span></button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="mat-actions">
    <a href="/Lists/@Model.List.Id" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>Zurück zur Liste</span></a>
</div>
