@page "/Lists/Edit/{id:long?}"
@using MatTrakr.Data
@using MatTrakr.ViewComponents
@model MatTrakr.Pages.Lists.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neue Liste" : "Liste bearbeiten";
    ViewData["Width"] = "narrow";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<div class="mat-card">
    <div class="mat-card__body">
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Id" />

            <div class="mat-field">
                <label asp-for="Name" class="mat-label">Name <span class="mat-req">*</span></label>
                <input asp-for="Name" class="mat-input" autofocus />
                <span asp-validation-for="Name" class="mat-error"></span>
            </div>

            <div class="mat-field">
                <label asp-for="Type" class="mat-label">Typ</label>
                @if (Model.IsNew)
                {
                    <select asp-for="Type" class="mat-select">
                        <option value="@MediaType.Movies">Movies</option>
                        <option value="@MediaType.Series">Series</option>
                        <option value="@MediaType.Books">Books</option>
                    </select>
                }
                else
                {
                    <input class="mat-input" value="@Model.Type" disabled />
                    <input type="hidden" asp-for="Type" />
                    <span class="mat-hint">Der Typ kann nachträglich nicht geändert werden.</span>
                }
            </div>

            <partial name="_FormActionsBar" model="@(new FormActionsModel
            {
                BackUrl = Model.IsNew ? "/" : $"/Lists/{Model.Id}",
                DeleteHandler = Model.IsNew ? null : "Delete",
                DeleteConfirm = "Liste inklusive aller Einträge wirklich löschen?",
            })" />
        </form>

        <partial name="_DeleteForm" model="@(new FormActionsModel
        {
            DeleteHandler = Model.IsNew ? null : "Delete",
            DeleteRouteValues = { ["id"] = Model.Id.ToString() },
        })" />
    </div>
</div>
