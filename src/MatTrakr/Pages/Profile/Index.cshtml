@page "/Profile"
@using MatTrakr.Data
@model MatTrakr.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Mein Konto";
    ViewData["Width"] = "narrow";
}

@* --- Account & display --- *@
<div class="mat-card">
    <div class="mat-card__head">@Ui.Icon("user-circle")<span class="mat-card__title">Konto &amp; Anzeige</span></div>
    <div class="mat-card__body">
        @if (!string.IsNullOrEmpty(Model.Success))
        {
            <div class="mat-alert mat-alert--success" role="status">@Ui.Icon("check-circle")<span>@Model.Success</span></div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
        }

        <form method="post" asp-page-handler="Account" class="mat-form">
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label asp-for="DisplayName" class="mat-label">Anzeigename</label>
                    <input asp-for="DisplayName" class="mat-input" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="username">Benutzername</label>
                    <input id="username" class="mat-input" value="@Model.Username" disabled />
                    <span class="mat-hint">Rolle: @Model.RoleName</span>
                </div>
            </div>

            <div class="mat-field">
                <span class="mat-label">Status-Anzeige auf den Kacheln</span>
                <div class="mat-form__grid">
                    <label class="mat-option">
                        <input type="radio" asp-for="CardStatusPosition" value="@CardStatusPosition.Above" id="posAbove" />
                        <span>
                            <strong>Über dem Cover</strong>
                            <span class="mat-hint mat-d-block">Kompaktes Tag oberhalb des Covers.</span>
                        </span>
                    </label>
                    <label class="mat-option">
                        <input type="radio" asp-for="CardStatusPosition" value="@CardStatusPosition.Below" id="posBelow" />
                        <span>
                            <strong>Unter dem Cover</strong>
                            <span class="mat-hint mat-d-block">Größer, über die volle Coverbreite.</span>
                        </span>
                    </label>
                </div>
            </div>

            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("check")<span>Speichern</span></button>
                <a href="/" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>Zurück</span></a>
            </div>
        </form>
    </div>
</div>

@* --- Password --- *@
<div class="mat-card">
    <div class="mat-card__head">@Ui.Icon("key")<span class="mat-card__title">Passwort ändern</span></div>
    <div class="mat-card__body">
        @if (!string.IsNullOrEmpty(Model.PasswordSuccess))
        {
            <div class="mat-alert mat-alert--success" role="status">@Ui.Icon("check-circle")<span>@Model.PasswordSuccess</span></div>
        }
        @if (!string.IsNullOrEmpty(Model.PasswordError))
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.PasswordError</span></div>
        }

        <form method="post" asp-page-handler="Password" class="mat-form">
            <div class="mat-field">
                <label asp-for="CurrentPassword" class="mat-label">Aktuelles Passwort</label>
                <input asp-for="CurrentPassword" type="password" class="mat-input" autocomplete="current-password" />
            </div>
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label asp-for="NewPassword" class="mat-label">Neues Passwort</label>
                    <input asp-for="NewPassword" type="password" class="mat-input" autocomplete="new-password" />
                </div>
                <div class="mat-field">
                    <label asp-for="ConfirmPassword" class="mat-label">Bestätigen</label>
                    <input asp-for="ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </div>
            </div>
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("check")<span>Passwort ändern</span></button>
            </div>
        </form>
    </div>
</div>
