@page "/Profile"
@using MatTrakr.Data
@model MatTrakr.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Mein Konto";
}

<h1 class="page-title"><i class="bi bi-person-circle"></i>Mein Konto</h1>

@* --- Account & display --- *@
<div class="content-card p-3 mb-3" style="max-width: 640px;">
    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <div class="alert alert-success" role="alert"><i class="bi bi-check-circle me-1"></i>@Model.Success</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.Error</div>
    }

    <form method="post" asp-page-handler="Account">
        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
                <label asp-for="DisplayName" class="form-label">Anzeigename</label>
                <input asp-for="DisplayName" class="form-control" />
            </div>
            <div class="col-12 col-sm-6">
                <label class="form-label">Benutzername</label>
                <input class="form-control" value="@Model.Username" disabled />
                <div class="form-text">Rolle: @Model.RoleName</div>
            </div>
        </div>

        <h2 class="fs-6 mb-1"><i class="bi bi-tags me-1"></i>Status-Anzeige auf den Kacheln</h2>
        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
                <input class="btn-check" type="radio" asp-for="CardStatusPosition" value="@CardStatusPosition.Above"
                       id="posAbove" autocomplete="off" />
                <label class="btn btn-outline-primary w-100 text-start p-3" for="posAbove">
                    <i class="bi bi-align-top me-1"></i><strong>Über dem Cover</strong>
                    <span class="d-block small text-muted">Kompaktes Tag oberhalb des Covers.</span>
                </label>
            </div>
            <div class="col-12 col-sm-6">
                <input class="btn-check" type="radio" asp-for="CardStatusPosition" value="@CardStatusPosition.Below"
                       id="posBelow" autocomplete="off" />
                <label class="btn btn-outline-primary w-100 text-start p-3" for="posBelow">
                    <i class="bi bi-align-bottom me-1"></i><strong>Unter dem Cover</strong>
                    <span class="d-block small text-muted">Größer, über die volle Coverbreite.</span>
                </label>
            </div>
        </div>

        <div class="form-actions">
            <div class="form-actions-main">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Speichern</button>
                <a href="/" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Zurück</a>
            </div>
        </div>
    </form>
</div>

@* --- Password --- *@
<div class="content-card p-3" style="max-width: 640px;">
    <h2 class="fs-5 mb-1"><i class="bi bi-key me-1"></i>Passwort ändern</h2>

    @if (!string.IsNullOrEmpty(Model.PasswordSuccess))
    {
        <div class="alert alert-success" role="alert"><i class="bi bi-check-circle me-1"></i>@Model.PasswordSuccess</div>
    }
    @if (!string.IsNullOrEmpty(Model.PasswordError))
    {
        <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.PasswordError</div>
    }

    <form method="post" asp-page-handler="Password">
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">Aktuelles Passwort</label>
            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
        </div>
        <div class="row g-3">
            <div class="col-12 col-sm-6">
                <label asp-for="NewPassword" class="form-label">Neues Passwort</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="ConfirmPassword" class="form-label">Bestätigen</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>
        </div>
        <div class="form-actions mt-3">
            <div class="form-actions-main">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Passwort ändern</button>
            </div>
        </div>
    </form>
</div>
