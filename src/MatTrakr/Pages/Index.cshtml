@page
@using MatTrakr.Data
@using MatTrakr.Services
@model IndexModel
@{
    ViewData["Title"] = "Meine Listen";
}

@functions {
    private static string TypeIcon(MediaType type) => type switch
    {
        MediaType.Movies => "film",
        MediaType.Series => "tv",
        MediaType.Books => "book",
        _ => "collection",
    };

    private static string DoneLabel(MediaType type) =>
        type == MediaType.Books ? "gelesen" : "gesehen";
}

<div class="mt-home-grid">
    @foreach (var card in Model.Cards)
    {
        var pct = card.Total == 0 ? 0 : card.Done * 100 / card.Total;
        <a href="/Lists/@card.List.Id" class="mat-card mat-card--link mt-home-card">
            <div class="mt-home-card__icon">@Ui.Icon(TypeIcon(card.List.Type))</div>
            <div class="mt-home-card__body">
                <div class="mt-home-card__title">@card.List.Name</div>
                <div class="mt-home-card__meta">
                    @card.Done von @card.Total @DoneLabel(card.List.Type)
                    @if (card.Access == ListAccess.ReadOnly)
                    {
                        <span class="mat-tag">Nur Lesen</span>
                    }
                    else if (card.Access != ListAccess.Owner)
                    {
                        <span class="mat-tag">Geteilt</span>
                    }
                </div>
                @if (card.Total > 0)
                {
                    <div class="mt-progress"><div class="mt-progress__bar" data-pct="@pct" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div></div>
                }
            </div>
        </a>
    }
</div>

<div class="mat-actions mat-mt-6">
    <a href="/Lists/Edit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>Neue Liste</span></a>
    <a href="/Lists/Manage" class="mat-btn mat-btn--secondary">@Ui.Icon("settings")<span>Listen verwalten</span></a>
</div>
