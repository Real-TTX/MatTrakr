@page
@model MatTrakr.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Passwort ändern";
    Layout = "_AuthLayout";
}

<h1 class="mt-auth-title">Passwort ändern</h1>
@if (Model.Forced)
{
    <div class="mat-alert mat-alert--info" role="alert">@Ui.Icon("info")<span>Bitte lege ein eigenes Passwort fest, bevor du fortfährst.</span></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<form method="post" class="mt-auth-form">
    <div class="mat-field">
        <label asp-for="CurrentPassword" class="mat-label">Aktuelles Passwort</label>
        <input asp-for="CurrentPassword" type="password" class="mat-input" autocomplete="current-password" autofocus />
        <span asp-validation-for="CurrentPassword" class="mat-error"></span>
    </div>
    <div class="mat-field">
        <label asp-for="NewPassword" class="mat-label">Neues Passwort</label>
        <input asp-for="NewPassword" type="password" class="mat-input" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="mat-error"></span>
    </div>
    <div class="mat-field">
        <label asp-for="ConfirmPassword" class="mat-label">Neues Passwort bestätigen</label>
        <input asp-for="ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="mat-error"></span>
    </div>

    <div class="mat-btn-row mat-btn-row--plain">
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("check")<span>Speichern</span></button>
        @if (!Model.Forced)
        {
            <a href="/" class="mat-btn mat-btn--secondary">@Ui.Icon("arrow-left")<span>Zurück</span></a>
        }
    </div>
</form>

@if (Model.Forced)
{
    <form method="post" action="/Account/Logout" class="mat-mt-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="mat-btn mat-btn--secondary mat-btn--block">@Ui.Icon("logout")<span>Abmelden</span></button>
    </form>
}
