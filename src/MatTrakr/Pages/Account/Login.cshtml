@page
@model MatTrakr.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Anmelden";
    Layout = "_AuthLayout";
}

<h1 class="mt-auth-title">Anmelden</h1>
<p class="mt-auth-sub">Melde dich an, um deine Listen zu verwalten.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

<form method="post" class="mt-auth-form">
    <input type="hidden" asp-for="ReturnUrl" value="@Model.ReturnUrl" />

    <div class="mat-field">
        <label asp-for="Username" class="mat-label">Benutzername</label>
        <div class="mat-input-icon">
            @Ui.Icon("user")
            <input asp-for="Username" class="mat-input" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Username" class="mat-error"></span>
    </div>

    <div class="mat-field">
        <label asp-for="Password" class="mat-label">Passwort</label>
        <div class="mat-input-icon">
            @Ui.Icon("lock")
            <input asp-for="Password" type="password" class="mat-input" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Password" class="mat-error"></span>
    </div>

    <label class="mat-check">
        <input asp-for="RememberMe" type="checkbox" />
        <span class="mat-check__text">Angemeldet bleiben</span>
    </label>

    <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("login")<span>Anmelden</span></button>
</form>
