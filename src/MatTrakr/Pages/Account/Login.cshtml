@page
@model MatTrakr.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Anmelden";
    Layout = "_AuthLayout";
}

<h1 class="mt-auth-title">Anmelden</h1>
<p class="mt-auth-sub">Melde dich an, um deine Listen zu verwalten.</p>

@if (Model.SsoError)
{
    <div id="login-sso-error" class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>Die Anmeldung über MatIdentity ist fehlgeschlagen oder MatIdentity ist gerade nicht erreichbar. Versuche es erneut oder melde dich hier mit deinem lokalen Konto an.</span></div>
}

@if (Model.IdentityEnabled)
{
    @if (Model.SignedOut)
    {
        <p class="mt-auth-sub">Du bist abgemeldet – hier und bei MatIdentity.</p>
    }
    <a id="login-sso" href="@Model.IdentitySignInUrl" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("login")<span>Mit MatIdentity anmelden</span></a>
    @if (!Model.ShowLocalForm)
    {
        <p class="mt-auth-sub"><a href="@Model.LocalSignInUrl">Mit lokalem Konto anmelden</a></p>
    }
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<span>@Model.Error</span></div>
}

@if (Model.ShowLocalForm)
{
<form method="post" class="mt-auth-form" id="login-form">
    <input type="hidden" asp-for="ReturnUrl" value="@Model.ReturnUrl" />

    <div class="mat-field">
        <label asp-for="Username" class="mat-label">Benutzername</label>
        <div class="mat-input-icon">
            @Ui.Icon("user")
            <input asp-for="Username" class="mat-input" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Username" class="mat-error"></span>
    </div>

    <div class="mat-field">
        <label asp-for="Password" class="mat-label">Passwort</label>
        <div class="mat-input-icon">
            @Ui.Icon("lock")
            <input asp-for="Password" type="password" class="mat-input" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Password" class="mat-error"></span>
    </div>

    <label class="mat-check">
        <input asp-for="RememberMe" type="checkbox" />
        <span class="mat-check__text">Angemeldet bleiben</span>
    </label>

    <button type="submit" class="mat-btn @(Model.IdentityEnabled ? "mat-btn--secondary" : "mat-btn--primary") mat-btn--block">@Ui.Icon("login")<span>Anmelden</span></button>
</form>
}
